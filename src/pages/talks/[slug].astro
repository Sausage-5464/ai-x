---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { useTranslations, withBase, type Lang } from "@/i18n/utils";

export async function getStaticPaths() {
  const talks = await getCollection("talks");
  return talks.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// 默认 zh,/en/talks/[slug].astro 会重新分发
const lang: Lang = "zh";
const t = useTranslations(lang);
const prefix = "";

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
});
---

<Layout title={entry.data.title} lang={lang}>
  <Container>
    <article class="mx-auto max-w-3xl mt-14">
      <span
        class="inline-block text-xs uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
        {entry.data.semester}
      </span>
      <h1
        class="text-3xl lg:text-4xl font-bold lg:tracking-tight mt-3 leading-tight">
        {entry.data.title}
      </h1>

      <dl class="mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
        <div>
          <dt class="text-slate-500">{t("talks.speaker")}</dt>
          <dd class="font-medium text-slate-800">{entry.data.speaker}</dd>
        </div>
        <div>
          <dt class="text-slate-500">{t("talks.affiliation")}</dt>
          <dd class="text-slate-800">{entry.data.affiliation}</dd>
        </div>
        <div>
          <dt class="text-slate-500">{t("talks.date")}</dt>
          <dd class="text-slate-800">
            <time datetime={entry.data.date.toISOString()}>
              {dateFormatter.format(entry.data.date)}
            </time>
          </dd>
        </div>
        {
          entry.data.tags.length > 0 && (
            <div>
              <dt class="text-slate-500">Tags</dt>
              <dd class="flex flex-wrap gap-2 mt-0.5">
                {entry.data.tags.map((tag) => (
                  <span class="text-xs text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                    #{tag}
                  </span>
                ))}
              </dd>
            </div>
          )
        }
      </dl>

      <div class="flex flex-wrap gap-3 mt-6">
        {
          entry.data.paperUrl && (
            <a
              href={entry.data.paperUrl}
              target="_blank"
              rel="noopener"
              class="text-sm px-3 py-1.5 bg-slate-900 text-white rounded-md hover:bg-slate-700">
              {t("talks.paper")} ↗
            </a>
          )
        }
        {
          entry.data.videoUrl && (
            <a
              href={entry.data.videoUrl}
              target="_blank"
              rel="noopener"
              class="text-sm px-3 py-1.5 border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50">
              {t("talks.video")} ↗
            </a>
          )
        }
        {
          entry.data.slidesUrl && (
            <a
              href={entry.data.slidesUrl}
              target="_blank"
              rel="noopener"
              class="text-sm px-3 py-1.5 border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50">
              {t("talks.slides")} ↗
            </a>
          )
        }
      </div>
    </article>

    <div class="mx-auto prose prose-lg mt-10 max-w-3xl">
      <Content />
    </div>
    <div class="text-center mt-10 mb-6">
      <a
        href={withBase(`${prefix}/talks`)}
        class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition">
        {t("talks.back")}
      </a>
    </div>
  </Container>
</Layout>
