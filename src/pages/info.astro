---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { useTranslations, withBase, type Lang } from "@/i18n/utils";

export interface Props {
  lang?: Lang;
}
const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const prefix = lang === "en" ? "/en" : "";
---

<Layout title={t("nav.info")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("info.title")}</Fragment>
      <Fragment slot="desc">{t("info.desc")}</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto mt-16">
      {/* 观众须知 */}
      <a href={withBase(`${prefix}/audience`)} class="flex flex-col border border-[var(--color-rule)] py-7 px-7 hover:border-[var(--color-accent)] transition group">
        <h3 class="text-xl font-serif font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">
          {t("info.audience.title")}
        </h3>
        <p class="text-sm text-[var(--color-slate)] mt-3">
          {lang === "zh" ? "如何参与讲座、加入微信群、观看回放等" : "How to participate, join WeChat group, watch recordings"}
        </p>
        <div class="mt-6 text-[var(--color-accent)] text-sm font-medium">
          {lang === "zh" ? "查看详情 →" : "View details →"}
        </div>
      </a>

      {/* 讲者须知 */}
      <a href={withBase(`${prefix}/speaker`)} class="flex flex-col border border-[var(--color-rule)] py-7 px-7 hover:border-[var(--color-accent)] transition group">
        <h3 class="text-xl font-serif font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">
          {t("info.speaker.title")}
        </h3>
        <p class="text-sm text-[var(--color-slate)] mt-3">
          {lang === "zh" ? "讲座格式、投稿要求、注意事项等" : "Talk format, submission requirements, notes"}
        </p>
        <div class="mt-6 text-[var(--color-accent)] text-sm font-medium">
          {lang === "zh" ? "查看详情 →" : "View details →"}
        </div>
      </a>
    </div>
  </Container>
</Layout>
