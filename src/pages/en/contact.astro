---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

const lang: Lang = "en";
const t = useTranslations(lang);
---

<Layout title={t("nav.contact")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("contact.title")}</Fragment>
      <Fragment slot="desc">{t("contact.desc")}</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-serif font-semibold text-xl text-[var(--color-ink)]">
          {t("contact.intro.h")}
        </h2>
        <p class="text-sm leading-relaxed text-[var(--color-slate)] mt-3">
          {t("contact.intro.p")}
        </p>
        <div class="mt-6 space-y-3 text-sm">
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>{t("contact.email")}: hello@ai-x-seminar.example</span>
          </div>
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>{t("contact.wechat")}: {t("contact.wechat.value")}</span>
          </div>
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>{t("contact.bilibili")}: {t("contact.bilibili.value")}</span>
          </div>
        </div>
      </div>
      <div>
        <Contactform lang={lang} />
      </div>
    </div>
  </Container>
</Layout>
