---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { useTranslations, withBase, type Lang } from "@/i18n/utils";

export interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const prefix = "/en";

const speakerFeatures = ([1, 2, 3, 4, 5, 6] as const).map((i) =>
  t(`info.speaker.f${i}` as const)
);
---

<Layout title={t("nav.info")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Speaker Guidelines</Fragment>
      <Fragment slot="desc">Guidelines for speakers at AI+X Seminar</Fragment>
    </Sectionhead>

    <div class="max-w-3xl mx-auto mt-16">
      <div class="flex flex-col border border-[var(--color-rule)] py-8 px-8">
        <ul class="mt-4 grid gap-y-4">
          {
            speakerFeatures.map((item) => (
              <li class="flex items-start gap-3 text-[var(--color-slate)] leading-relaxed">
                <span class="text-[var(--color-accent)] mt-0.5">✦</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8">
          <a href={withBase(`${prefix}/signup`)} class="inline-block px-6 py-3 text-sm border border-[var(--color-accent)] text-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-white transition">
            {t("info.speaker.cta")}
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>
