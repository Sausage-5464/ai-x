---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { getCollection } from "astro:content";
import { useTranslations, type Lang } from "@/i18n/utils";

const lang: Lang = "en";
const t = useTranslations(lang);
const prefix = "/en";

// Get all talks
const allTalks = await getCollection("talks", ({ data }) => !data.draft);
allTalks.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by semester
const bySemester = new Map<string, typeof allTalks>();
for (const talk of allTalks) {
  const key = talk.data.semester;
  if (!bySemester.has(key)) bySemester.set(key, []);
  bySemester.get(key)!.push(talk);
}

// Recent news
const recentNews = [
  { date: "2026.06.20", text: "2026 R01 semester schedule is now live!" },
  { date: "2026.06.13", text: "Talk #6: Expressivity of MoE — Theoretical Analysis" },
  { date: "2026.06.06", text: "Talk #5: Combining RL and LLM Priors" },
  { date: "2026.05.30", text: "Talk #4: Diffusion Sampling Optimization" },
];

// Organizers
const organizers = [
  { name: "Ming Li", affiliation: "Tsinghua University", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=ML&backgroundColor=9b2335&textColor=ffffff" },
  { name: "Fang Wang", affiliation: "Peking University", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=FW&backgroundColor=9b2335&textColor=ffffff" },
  { name: "Wei Zhang", affiliation: "Chinese Academy of Sciences", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=WZ&backgroundColor=9b2335&textColor=ffffff" },
  { name: "Yang Liu", affiliation: "Shanghai Jiao Tong", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=YL&backgroundColor=9b2335&textColor=ffffff" },
  { name: "Jing Chen", affiliation: "Zhejiang University", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=JC&backgroundColor=9b2335&textColor=ffffff" },
  { name: "Qiang Zhao", affiliation: "Fudan University", avatar: "https://api.dicebear.com/7.x/initials/svg?seed=QZ&backgroundColor=9b2335&textColor=ffffff" },
];

// Partners
const partners = [
  { name: "AI TIME", logo: "https://api.dicebear.com/7.x/shapes/svg?seed=AITIME&backgroundColor=1c1c1c" },
  { name: "Kuxiang Academic", logo: "https://api.dicebear.com/7.x/shapes/svg?seed=KUXIANG&backgroundColor=1c1c1c" },
  { name: "PaperWeekly", logo: "https://api.dicebear.com/7.x/shapes/svg?seed=PW&backgroundColor=1c1c1c" },
];

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short", day: "numeric"
});
---

<Layout lang={lang}>
  <!-- Hero Section -->
  <section class="py-12 lg:py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 max-w-3xl">
          <p class="section-marker mb-2">AI+X Seminar · Cross-disciplinary AI</p>
          <h1 class="hero-title">AI+X Seminar</h1>
          <hr class="rule-accent my-4 w-24" />
          <p class="hero-subtitle mb-6">
            Exploring the intersection of AI with other fields, covering AI+Science, cross-modality, and interdisciplinary innovation.
          </p>

          <!-- Info Cards - compact -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <div class="info-card">
              <p class="label">Theme</p>
              <p class="value">Cross-disciplinary AI</p>
            </div>
            <div class="info-card">
              <p class="label">Time</p>
              <p class="value">Fridays 10:00–11:00 (UTC+8)</p>
            </div>
            <div class="info-card">
              <p class="label">Platform</p>
              <p class="value">Bilibili · WeChat</p>
            </div>
          </div>
        </div>

        <!-- QR Codes placeholder -->
        <div class="lg:w-56 flex flex-col items-center justify-center gap-4">
          <!-- WeChat QR -->
          <div class="border border-[var(--color-rule)] rounded p-3 text-center bg-white">
            <div class="w-28 h-28 bg-[var(--color-rule)] mb-2 flex items-center justify-center text-xs text-[var(--color-muted)]">
              <!-- TODO: Add WeChat QR code image here -->
              <span>WeChat OA QR</span>
            </div>
            <p class="text-xs text-[var(--color-slate)]">WeChat OA</p>
          </div>
          <!-- Bilibili QR -->
          <div class="border border-[var(--color-rule)] rounded p-3 text-center bg-white">
            <div class="w-28 h-28 bg-[var(--color-rule)] mb-2 flex items-center justify-center text-xs text-[var(--color-muted)]">
              <!-- TODO: Add Bilibili QR code image here -->
              <span>Bilibili QR</span>
            </div>
            <p class="text-xs text-[var(--color-slate)]">Bilibili</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- News Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">Recent News</h2>
        <span class="section-marker">News</span>
      </div>
      <hr class="rule-subtle mb-0" />
      <div class="max-w-2xl">
        {recentNews.map((item) => (
          <div class="news-item">
            <span class="date">{item.date}</span>
            <span class="text-sm">{item.text}</span>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Schedule Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">Schedule</h2>
        <span class="section-marker">Schedule by Semester</span>
      </div>
      <hr class="rule-subtle mb-0" />

      {[...bySemester.entries()].map(([semester, talks]) => (
        <details class="schedule-semester" open={semester === "2026 R01"}>
          <summary>{semester}</summary>
          <div class="overflow-x-auto mt-4">
            <table class="schedule-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Speaker</th>
                  <th class="hidden md:table-cell">Affiliation</th>
                  <th class="hidden sm:table-cell">Title</th>
                  <th class="hidden lg:table-cell">Paper</th>
                  <th>Video</th>
                </tr>
              </thead>
              <tbody>
                {talks.map((talk) => (
                  <tr>
                    <td class="date-col">{dateFormatter.format(talk.data.date)}</td>
                    <td class="speaker-col">{talk.data.speaker}</td>
                    <td class="affiliation-col hidden md:table-cell">{talk.data.affiliation}</td>
                    <td class="title-col hidden sm:table-cell">{talk.data.title}</td>
                    <td class="link-col hidden lg:table-cell">
                      {talk.data.paperUrl && (
                        <a href={talk.data.paperUrl} target="_blank" rel="noopener">Paper</a>
                      )}
                    </td>
                    <td class="link-col">
                      {talk.data.videoUrl && (
                        <a href={talk.data.videoUrl} target="_blank" rel="noopener">Video</a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
    </Container>
  </section>

  <!-- Organizers Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">Organizers</h2>
        <span class="section-marker">Core Team</span>
      </div>
      <hr class="rule-subtle mb-0" />

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-6">
        {organizers.map((org) => (
          <div class="organizer-card">
            <img class="avatar" src={org.avatar} alt={org.name} />
            <p class="name">{org.name}</p>
            <p class="affiliation">{org.affiliation}</p>
          </div>
        ))}
      </div>

      <!-- Contributors -->
      <div class="mt-12 pt-8 border-t border-[var(--color-rule)]">
        <h3 class="text-lg mb-4">Contributors</h3>
        <div class="flex flex-wrap gap-2 text-sm text-[var(--color-slate)]">
          {[
            "Ming Li", "Fang Wang", "Wei Zhang", "Yang Liu", "Jing Chen", "Qiang Zhao",
            "Li Sun", "Jie Zhou", "Lei Wu", "Xin Zheng",
            "Ting Huang", "Peng Xu", "Chao Ma", "Lin Zhu",
            "Jun Hu", "Feng Lin", "Xue He", "Yang Gao",
            "Hao Luo", "Fang Guo", "Huan Wu", "Tao Xu",
          ].map((name) => (
            <span class="px-3 py-1 bg-[var(--color-paper)] border border-[var(--color-rule)] rounded text-xs">
              {name}
            </span>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Partners Section -->
  <section class="py-16 border-b border-[var(--color-rule)]">
    <Container>
      <div class="flex items-baseline gap-6 mb-6">
        <h2 class="text-xl">Partners</h2>
        <span class="section-marker">Collaborations</span>
      </div>
      <hr class="rule-subtle mb-0" />

      <div class="flex flex-wrap gap-8 items-center mt-6">
        {partners.map((partner) => (
          <div class="flex items-center gap-3">
            <img class="partner-logo" src={partner.logo} alt={partner.name} />
            <span class="text-sm font-medium">{partner.name}</span>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA Section -->
  <section class="py-16">
    <Container>
      <div class="max-w-xl mx-auto text-center">
        <h2 class="text-2xl mb-4">Join the Discussion</h2>
        <p class="text-[var(--color-slate)] mb-6">
          Follow our WeChat channel and send [Join] to receive weekly talk notifications.
        </p>
        <a
          href={`${prefix}/talks`}
          class="inline-block px-6 py-3 bg-[var(--color-accent)] text-white font-medium rounded hover:bg-[var(--color-gold)] transition">
          View Past Talks →
        </a>
      </div>
    </Container>
  </section>
</Layout>
