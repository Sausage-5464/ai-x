---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

const lang: Lang = "en";
const t = useTranslations(lang);
const prefix = "/en";

const allTalks = await getCollection("talks", ({ data }) => !data.draft);
allTalks.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const bySemester = new Map<string, typeof allTalks>();
for (const talk of allTalks) {
  const key = talk.data.semester;
  if (!bySemester.has(key)) bySemester.set(key, []);
  bySemester.get(key)!.push(talk);
}

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short", day: "numeric"
});
---

<Layout title={t("nav.talks")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("talks.title")}</Fragment>
      <Fragment slot="desc">{t("talks.desc")}</Fragment>
    </Sectionhead>

    <main class="mt-16 max-w-4xl mx-auto">
      {
        [...bySemester.entries()].map(([semester, talks]) => (
          <section class="mb-12">
            <details class="schedule-semester" open>
              <summary>{semester}</summary>
              <div class="overflow-x-auto mt-4">
                <table class="schedule-table">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Speaker</th>
                      <th class="hidden md:table-cell">Affiliation</th>
                      <th class="hidden sm:table-cell">Title</th>
                      <th class="hidden lg:table-cell">Paper</th>
                      <th>Video</th>
                    </tr>
                  </thead>
                  <tbody>
                    {talks.map((entry) => (
                      <tr>
                        <td class="date-col">{dateFormatter.format(entry.data.date)}</td>
                        <td class="speaker-col">{entry.data.speaker}</td>
                        <td class="affiliation-col hidden md:table-cell">{entry.data.affiliation}</td>
                        <td class="title-col hidden sm:table-cell">{entry.data.title}</td>
                        <td class="link-col hidden lg:table-cell">
                          {entry.data.paperUrl && (
                            <a href={entry.data.paperUrl} target="_blank" rel="noopener">Paper</a>
                          )}
                        </td>
                        <td class="link-col">
                          {entry.data.videoUrl && (
                            <a href={entry.data.videoUrl} target="_blank" rel="noopener">Video</a>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </section>
        ))
      }
    </main>
  </Container>
</Layout>
