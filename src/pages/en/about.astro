---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

const lang: Lang = "en";
const t = useTranslations(lang);

const organizers = (await getCollection("organizers", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const logistics = [
  { label: t("about.logistics.time"), value: t("about.logistics.time.value") },
  { label: t("about.logistics.lang"), value: t("about.logistics.lang.value") },
  {
    label: t("about.logistics.platform"),
    value: t("about.logistics.platform.value"),
  },
  {
    label: t("about.logistics.archive"),
    value: t("about.logistics.archive.value"),
  },
];

function initials(name: string, nameEn?: string) {
  if (nameEn) {
    const parts = nameEn.trim().split(/\s+/);
    return parts.map((p) => p[0]).join("").toUpperCase().slice(0, 2);
  }
  return name.slice(0, 1);
}
---

<Layout title={t("nav.about")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("about.title")}</Fragment>
      <Fragment slot="desc">{t("about.desc")}</Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-3 mx-auto max-w-3xl mt-16">
      <h2 class="font-serif font-bold text-2xl text-[var(--color-ink)] leading-snug">
        {t("about.intro.h")}
      </h2>
      <p class="text-base leading-relaxed text-[var(--color-slate)] mt-2">
        {t("about.intro.p")}
      </p>
    </div>

    <div class="mx-auto max-w-3xl mt-16">
      <h3 class="text-xl font-serif font-semibold text-[var(--color-ink)]">
        {t("about.logistics.title")}
      </h3>
      <dl class="mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-5 border-t border-[var(--color-rule)] pt-6">
        {
          logistics.map((row) => (
            <div>
              <dt class="text-xs uppercase tracking-wider text-[var(--color-muted)]">
                {row.label}
              </dt>
              <dd class="mt-1 text-sm text-[var(--color-ink)]">{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="mx-auto max-w-5xl mt-20">
      <h3 class="text-xl font-serif font-semibold text-[var(--color-ink)] text-center">
        {t("about.organizers.title")}
      </h3>
      <p class="text-center text-[var(--color-slate)] mt-3 max-w-2xl mx-auto text-sm">
        {t("about.organizers.desc")}
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 md:gap-8 mt-12">
        {
          organizers.map((entry) => {
            const displayName = entry.data.nameEn ?? entry.data.name;
            const displayAff = entry.data.affiliationEn ?? entry.data.affiliation;
            return (
              <div class="flex flex-col items-center text-center">
                <div class="size-20 rounded-full bg-[var(--color-paper)] border-2 border-[var(--color-rule)] flex items-center justify-center text-xl font-semibold text-[var(--color-slate)]">
                  {initials(entry.data.name, entry.data.nameEn)}
                </div>
                <div class="mt-3">
                  {entry.data.homepage ? (
                    <a
                      href={entry.data.homepage}
                      target="_blank"
                      rel="noopener"
                      class="font-medium text-[var(--color-ink)] hover:text-[var(--color-accent)]">
                      {displayName}
                    </a>
                  ) : (
                    <span class="font-medium text-[var(--color-ink)]">{displayName}</span>
                  )}
                  <div class="text-xs text-[var(--color-muted)] mt-1">{displayAff}</div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </Container>
</Layout>
