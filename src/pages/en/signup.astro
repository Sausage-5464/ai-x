---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

export interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---

<Layout title={t("nav.signup")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Apply as Speaker</Fragment>
      <Fragment slot="desc">Apply to speak at AI+X Seminar</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-serif font-semibold text-xl text-[var(--color-ink)]">
          Become a Speaker
        </h2>
        <p class="text-sm leading-relaxed text-[var(--color-slate)] mt-3">
          We welcome PhD students and early-career researchers to apply. Please fill out the form or contact us via email.
        </p>
        <div class="mt-6 space-y-3 text-sm">
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>{t("contact.email")}: hello@ai-x-seminar.example</span>
          </div>
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>Bilibili: @AI+X-Seminar</span>
          </div>
        </div>
      </div>
      <div>
        <Contactform lang={lang} />
      </div>
    </div>
  </Container>
</Layout>
