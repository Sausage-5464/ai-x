---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

export interface Props {
  lang?: Lang;
}
const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---

<Layout title={t("nav.signup")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("nav.signup")}</Fragment>
      <Fragment slot="desc">{lang === "zh" ? "申请成为 AI+X Seminar 的讲者" : "Apply to speak at AI+X Seminar"}</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-serif font-semibold text-xl text-[var(--color-ink)]">
          {lang === "zh" ? "成为讲者" : "Become a Speaker"}
        </h2>
        <p class="text-sm leading-relaxed text-[var(--color-slate)] mt-3">
          {lang === "zh"
            ? "我们欢迎在读博士生及青年研究者申请分享自己的工作。请填写右侧表单或通过邮件与我们联系。"
            : "We welcome PhD students and early-career researchers to apply. Please fill out the form or contact us via email."}
        </p>
        <div class="mt-6 space-y-3 text-sm">
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>{t("contact.email")}: hello@ai-x-seminar.example</span>
          </div>
          <div class="flex items-center gap-2 text-[var(--color-slate)]">
            <span class="text-[var(--color-accent)]">✦</span>
            <span>Bilibili: @AI+X-Seminar</span>
          </div>
        </div>
      </div>
      <div>
        <Contactform lang={lang} />
      </div>
    </div>
  </Container>
</Layout>
