---
// @ts-ignore
import { Icon } from "astro-icon/components";
import { useTranslations, type Lang } from "@/i18n/utils";

const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const features = [
  { key: "f1", icon: "bx:bxs-calendar" },
  { key: "f2", icon: "bx:bxs-chat" },
  { key: "f3", icon: "bx:bxs-video" },
  { key: "f4", icon: "bx:bxs-brain" },
  { key: "f5", icon: "bx:bxs-group" },
  { key: "f6", icon: "bx:bxs-microphone" },
] as const;
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    {t("features.title")}
  </h2>
  <p class="text-lg mt-4 text-slate-600 max-w-3xl">
    {t("features.subtitle")}
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-12">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full p-2 w-9 h-9 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">
            {t(`features.${item.key}.title` as const)}
          </h3>
          <p class="text-slate-500 mt-2 leading-relaxed">
            {t(`features.${item.key}.desc` as const)}
          </p>
        </div>
      </div>
    ))
  }
</div>
