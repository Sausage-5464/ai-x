---
import Link from "./ui/link.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const infoHref = lang === "en" ? "/en/info" : "/info";
---

<div
  class="bg-slate-900 p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-2xl flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-5xl font-semibold tracking-tight">
    {t("cta.title")}
  </h2>
  <p class="text-slate-300 mt-4 text-lg md:text-xl max-w-2xl">
    {t("cta.desc")}
  </p>
  <div class="flex mt-6">
    <Link href={infoHref} style="inverted">{t("cta.button")}</Link>
  </div>
</div>
