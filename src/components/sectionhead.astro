---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-16", align === "center" && "text-center"]}>
  <h1 class="text-3xl lg:text-4xl font-serif font-bold tracking-tight text-[var(--color-ink)]">
    <slot name="title">Title</slot>
  </h1>
  <hr class="rule-accent my-4 mx-auto w-16" />
  <p class="text-base mt-4 text-[var(--color-slate)] max-w-2xl mx-auto">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>
