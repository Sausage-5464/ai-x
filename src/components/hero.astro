---
import Link from "@/components/ui/link.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const talksHref = lang === "en" ? "/en/talks" : "/talks";
const contactHref = lang === "en" ? "/en/contact" : "/contact";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-12 md:pt-20 md:pb-24 gap-10">
  <div>
    <p
      class="inline-block mb-4 text-xs uppercase tracking-wider font-semibold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
      {t("hero.time")}
    </p>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      {t("hero.title")}
    </h1>
    <p class="text-lg mt-6 text-slate-600 max-w-xl leading-relaxed">
      {t("hero.subtitle")}
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <Link href={talksHref} class="flex gap-1 items-center justify-center">
        {t("hero.cta.upcoming")}
      </Link>
      <Link
        size="lg"
        style="outline"
        href={contactHref}
        class="flex gap-1 items-center justify-center">
        {t("hero.cta.subscribe")}
      </Link>
    </div>
  </div>
  <div
    class="hidden md:flex items-center justify-center w-full aspect-square max-w-md rounded-2xl bg-gradient-to-br from-indigo-50 via-white to-slate-100 border border-slate-100">
    <div class="text-center px-8">
      <div
        class="text-7xl lg:text-8xl font-bold tracking-tighter text-slate-800">
        AI<span class="text-indigo-500">·x</span>
      </div>
      <div class="mt-4 text-sm uppercase tracking-[0.3em] text-slate-400">
        Seminar
      </div>
      <div class="mt-8 inline-flex items-center gap-2 text-xs text-slate-500">
        <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {lang === "zh" ? "周五开讲" : "Fridays Live"}
      </div>
    </div>
  </div>
</main>
