---
import Container from "@/components/container.astro";
import {
  useTranslations,
  switchLangPath,
  withBase,
  type Lang,
} from "@/i18n/utils";

const { lang = "zh" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const prefix = lang === "en" ? "/en" : "";
const menuitems = [
  { title: t("nav.home"), path: prefix + "/" },
  { title: lang === "zh" ? "基础信息" : "Basic Info", path: prefix + "/about" },
  { title: t("nav.talks"), path: prefix + "/talks" },
  { title: lang === "zh" ? "观众须知" : "Audience", path: prefix + "/audience" },
  { title: lang === "zh" ? "讲者须知" : "For Speakers", path: prefix + "/speaker" },
  { title: lang === "zh" ? "讲者报名" : "Apply", path: prefix + "/signup" },
  { title: t("nav.contact"), path: prefix + "/contact" },
];

const otherLang: Lang = lang === "zh" ? "en" : "zh";
const otherLangLabel = lang === "zh" ? "EN" : "中";
const otherLangPath = switchLangPath(Astro.url, otherLang);
const homePath = withBase(prefix + "/");
---

<header class="border-b border-[var(--color-rule)] sticky top-0 bg-[var(--color-paper)] z-50">
  <Container>
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={homePath} class="flex items-center gap-2 group">
        <div class="w-8 h-8 bg-[var(--color-accent)] rounded flex items-center justify-center">
          <span class="text-white font-serif font-bold text-sm">AI</span>
        </div>
        <span class="font-serif font-bold text-[var(--color-ink)] tracking-tight">
          {lang === "zh" ? "AI+X Seminar" : "AI+X Seminar"}
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-6">
        {menuitems.map((item) => (
          <a
            href={withBase(item.path)}
            class="text-sm text-[var(--color-slate)] hover:text-[var(--color-accent)] transition border-b border-transparent hover:border-[var(--color-accent)] pb-0.5">
            {item.title}
          </a>
        ))}
      </nav>

      <!-- Language Toggle -->
      <div class="flex items-center gap-3">
        <a
          href={withBase(otherLangPath)}
          aria-label="Switch language"
          class="inline-flex items-center justify-center w-9 h-9 text-sm font-mono font-medium text-[var(--color-slate)] hover:text-[var(--color-accent)] border border-[var(--color-rule)] rounded hover:border-[var(--color-accent)] transition">
          {otherLangLabel}
        </a>

        <!-- Mobile menu button -->
        <button
          class="lg:hidden p-2 text-[var(--color-slate)]"
          aria-label="Menu"
          id="mobile-menu-btn">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <nav class="lg:hidden hidden pb-4" id="mobile-menu">
      <div class="flex flex-col gap-2">
        {menuitems.map((item) => (
          <a
            href={withBase(item.path)}
            class="text-sm text-[var(--color-slate)] hover:text-[var(--color-accent)] py-1">
            {item.title}
          </a>
        ))}
      </div>
    </nav>
  </Container>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
